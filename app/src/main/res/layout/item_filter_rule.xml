<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filter_rule_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ripple_all_corners"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="@dimen/medium_margin"
    android:paddingBottom="@dimen/medium_margin">

    <org.fossify.commons.views.MyAppCompatCheckbox
        android:id="@+id/filter_rule_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/activity_margin" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/filter_rule_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:layout_toStartOf="@+id/filter_rule_enabled"
        android:textSize="@dimen/bigger_text_size"
        android:textStyle="bold" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/filter_rule_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/filter_rule_title"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:layout_toStartOf="@+id/filter_rule_enabled"
        android:alpha="0.7"
        android:textSize="@dimen/normal_text_size" />

</RelativeLayout>
