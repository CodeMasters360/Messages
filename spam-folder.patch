@@ -0,0 +1,174 @@
+name: Build APK and publish release
+
+# Manual workflow: Actions tab -> "Build APK and publish release" -> Run workflow.
+# After a successful build it ALWAYS creates a GitHub Release in THIS repository
+# (a unique tag is generated on every run, so no tag/version bump is needed)
+# and attaches the final APK file(s) to it.
+
+on:
+  workflow_dispatch:
+    inputs:
+      prerelease:
+        description: "Mark the release as a pre-release"
+        type: boolean
+        default: false
+
+permissions:
+  contents: write
+
+concurrency:
+  group: build-and-release-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  build-and-release:
+    name: Build and publish release
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    env:
+      # Optional repository secrets. If they are NOT set, a signing key is generated
+      # automatically (and cached) so the APK is always signed and installable.
+      ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+      SECRET_KEY_ALIAS: ${{ secrets.SIGNING_KEY_ALIAS }}
+      SECRET_KEY_PASSWORD: ${{ secrets.SIGNING_KEY_PASSWORD }}
+      SECRET_STORE_PASSWORD: ${{ secrets.SIGNING_STORE_PASSWORD }}
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v5
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v5
+        with:
+          distribution: temurin
+          java-version: 17
+
+      - name: Set up Gradle (with cache)
+        uses: gradle/actions/setup-gradle@v5
+
+      - name: Read version information
+        id: info
+        run: |
+          VERSION_NAME=$(grep '^VERSION_NAME=' gradle.properties | cut -d= -f2 | tr -d '\r')
+          VERSION_CODE=$(grep '^VERSION_CODE=' gradle.properties | cut -d= -f2 | tr -d '\r')
+          SHORT_SHA="${GITHUB_SHA::7}"
+          TAG="v${VERSION_NAME}-spam-build${GITHUB_RUN_NUMBER}"
+          {
+            echo "version_name=${VERSION_NAME}"
+            echo "version_code=${VERSION_CODE}"
+            echo "short_sha=${SHORT_SHA}"
+            echo "tag=${TAG}"
+          } >> "$GITHUB_OUTPUT"
+          echo "Version: ${VERSION_NAME} (${VERSION_CODE}), commit ${SHORT_SHA}, tag ${TAG}"
+
+      # When no signing secrets exist, reuse a previously generated key (if cached)
+      # so that new builds can be installed over older ones.
+      - name: Restore generated signing key from cache
+        if: env.ANDROID_KEYSTORE_BASE64 == ''
+        uses: actions/cache@v5
+        with:
+          path: app/release.jks
+          key: fork-release-keystore-v1
+
+      - name: Prepare signing key
+        id: signing
+        run: |
+          KEYSTORE_PATH="$GITHUB_WORKSPACE/app/release.jks"
+          if [ -n "$ANDROID_KEYSTORE_BASE64" ]; then
+            echo "$ANDROID_KEYSTORE_BASE64" | base64 --decode > "$KEYSTORE_PATH"
+            ALIAS="$SECRET_KEY_ALIAS"
+            KEY_PASS="$SECRET_KEY_PASSWORD"
+            STORE_PASS="$SECRET_STORE_PASSWORD"
+            echo "source=repository secrets" >> "$GITHUB_OUTPUT"
+          else
+            ALIAS="fork-release"
+            KEY_PASS="fork-build-password"
+            STORE_PASS="fork-build-password"
+            if [ -f "$KEYSTORE_PATH" ]; then
+              echo "source=cached generated key" >> "$GITHUB_OUTPUT"
+            else
+              keytool -genkeypair -noprompt \
+                -keystore "$KEYSTORE_PATH" \
+                -storepass "$STORE_PASS" -keypass "$KEY_PASS" \
+                -alias "$ALIAS" -keyalg RSA -keysize 2048 -validity 36500 \
+                -dname "CN=Fossify Messages Fork, O=Personal, C=US"
+              echo "source=newly generated key" >> "$GITHUB_OUTPUT"
+            fi
+          fi
+          {
+            echo "SIGNING_STORE_FILE=$KEYSTORE_PATH"
+            echo "SIGNING_KEY_ALIAS=$ALIAS"
+            echo "SIGNING_KEY_PASSWORD=$KEY_PASS"
+            echo "SIGNING_STORE_PASSWORD=$STORE_PASS"
+          } >> "$GITHUB_ENV"
+
+      - name: Build release APK (foss flavor)
+        run: |
+          chmod +x ./gradlew
+          ./gradlew assembleFossRelease --stacktrace
+
+      - name: Collect APK files
+        id: apks
+        run: |
+          mkdir -p release-assets
+          shopt -s nullglob
+          for f in app/build/outputs/apk/foss/release/*.apk; do
+            cp "$f" "release-assets/FossifyMessages-${{ steps.info.outputs.version_name }}-spam-build${GITHUB_RUN_NUMBER}-$(basename "$f")"
+          done
+          COUNT=$(ls release-assets/*.apk 2>/dev/null | wc -l)
+          if [ "$COUNT" -lt 1 ]; then
+            echo "::error::No APK was produced by the build"
+            exit 1
+          fi
+          echo "Found ${COUNT} APK file(s):"
+          ls -lh release-assets
+
+      - name: Upload APKs as workflow artifact
+        uses: actions/upload-artifact@v5
+        with:
+          name: apk-${{ steps.info.outputs.tag }}
+          path: release-assets/*.apk
+          if-no-files-found: error
+
+      - name: Create (or force-replace) the GitHub release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TAG: ${{ steps.info.outputs.tag }}
+          VERSION_NAME: ${{ steps.info.outputs.version_name }}
+          SHORT_SHA: ${{ steps.info.outputs.short_sha }}
+          SIGNING_SOURCE: ${{ steps.signing.outputs.source }}
+          PRERELEASE: ${{ inputs.prerelease }}
+        run: |
+          TITLE="Fossify Messages ${VERSION_NAME} + Spam folder (build ${GITHUB_RUN_NUMBER})"
+
+          cat > release-notes.md <<NOTES
+          Custom build of Fossify Messages ${VERSION_NAME} with:
+
+          - **Spam folder**: messages detected as spam (blocked numbers, blocked sender names such as "Google", blocked keywords, unknown senders when blocking is enabled) are moved to the Spam folder instead of being deleted, and they never trigger a notification.
+          - Alphanumeric sender IDs can be blocked (case-insensitive, \`*\` wildcard supported).
+
+          Commit: ${GITHUB_SHA}
+          Signed with: ${SIGNING_SOURCE}
+          Workflow run: ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}
+          NOTES
+          # Force: delete a previous release/tag with the same name (e.g. when re-running a job)
+          gh release delete "$TAG" --cleanup-tag --yes >/dev/null 2>&1 || true
+
+          EXTRA_FLAGS="--latest"
+          if [ "$PRERELEASE" = "true" ]; then
+            EXTRA_FLAGS="--prerelease"
+          fi
+
+          gh release create "$TAG" release-assets/*.apk \
+            --repo "$GITHUB_REPOSITORY" \
+            --target "$GITHUB_SHA" \
+            --title "$TITLE" \
+            --notes-file release-notes.md \
+            $EXTRA_FLAGS
+
+          {
+            echo "### Release published"
+            echo ""
+            echo "- Tag: \`${TAG}\`"
+            echo "- Signed with: ${SIGNING_SOURCE}"
+            echo "- ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/releases/tag/${TAG}"
+          } >> "$GITHUB_STEP_SUMMARY"
